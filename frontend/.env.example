# Variables del frontend (Vite). Solo las que empiezan con VITE_ llegan al navegador: acá NUNCA van secretos.

# Origen de la API cuando el frontend se publica aparte (Static Site de Render) y la API vive en otro dominio.
# Vacío (lo normal en desarrollo): la app pide a /api en el mismo origen y Vite lo pasa al backend local.
# En producción: https://api.mgdetail.com.ar (sin barra final y sin /api; se valida al compilar).
# VITE_API_URL=https://api.mgdetail.com.ar
