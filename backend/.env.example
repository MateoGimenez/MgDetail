# ---------------------------------------------------------------------------
# MgDetailing - backend. Variables de entorno.
#
# Copiá este archivo a ".env" (cp .env.example .env  /  copy .env.example .env)
# y completá los valores. NUNCA subas el ".env" real al repositorio: tiene secretos.
# Las variables definidas en el entorno del sistema tienen prioridad sobre las de este archivo.
# Una variable vacía (VARIABLE=) se trata como si no estuviera definida.
#
# En desarrollo no hace falta ninguna: todo tiene un valor por defecto seguro.
# ---------------------------------------------------------------------------

# Entorno: development | test | production
# En production se exigen JWT_SECRET y FRONTEND_ORIGIN, y la cookie de sesión pasa a ser "Secure" (solo HTTPS).
NODE_ENV=development

# Puerto donde escucha la API.
PORT=4000

# Interfaz donde escucha. Por defecto 127.0.0.1 (solo esta máquina): lo recomendado detrás de un proxy
# inverso en el mismo servidor (Caddy, nginx). En Docker o en un PaaS (Render, Railway, Fly) hay que usar
# HOST=0.0.0.0 para que la plataforma pueda llegar al proceso.
HOST=127.0.0.1

# Origen(es) del frontend permitidos por CORS y por el chequeo de Origin (defensa CSRF).
# Tiene que ser EXACTAMENTE el origen que ve el navegador: esquema + host + puerto, sin barra final ni ruta.
#  - Desarrollo (Vite): http://localhost:5173
#  - Producción: el dominio público, ej.: https://mgdetailing.com.ar
# Para varios orígenes, separalos con comas. Útil para probar desde el celular por la red local:
#   FRONTEND_ORIGIN=http://localhost:5173,http://192.168.0.10:5173
# Obligatorio en producción. No se aceptan comodines (*).
FRONTEND_ORIGIN=http://localhost:5173

# Secreto con el que se firman las sesiones (JWT HS256). Mínimo 32 caracteres, aleatorio y privado.
# Obligatorio en producción. En desarrollo, si falta, se genera uno al azar en cada arranque
# (y las sesiones se pierden al reiniciar el servidor). Para generar uno:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Cambiarlo cierra todas las sesiones abiertas.
JWT_SECRET=

# Archivo de la base SQLite. Las rutas relativas se resuelven desde la carpeta backend/ (no desde donde
# se ejecute el comando). La carpeta se crea sola. En producción apuntalo a un volumen persistente.
DB_PATH=./storage/mgdetailing.db

# Cuántos proxies inversos hay entre el visitante y la API, para que el rate limit vea la IP real
# (X-Forwarded-For). Valores: false (sin proxy), un número (1 = un proxy, ej. Caddy/nginx/PaaS) o una lista
# de IP/CIDR de confianza (ej.: 10.0.0.0/8, loopback). "true" NO se acepta: permitiría falsear la IP.
# Si lo dejás en false detrás de un proxy, todos los visitantes comparten la IP del proxy.
TRUST_PROXY=false

# true: la API también sirve el build del frontend (../frontend/dist) con fallback SPA a index.html
# para las rutas que no empiezan con /api. Es la forma de desplegar en un solo proceso y mismo origen.
SERVE_FRONTEND=false
