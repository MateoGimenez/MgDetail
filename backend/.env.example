# ---------------------------------------------------------------------------
# MgDetailing - backend. Variables de entorno.
#
# Copiá este archivo a ".env" (cp .env.example .env  /  copy .env.example .env)
# y completá los valores. NUNCA subas el ".env" real al repositorio: tiene secretos.
# Las variables definidas en el entorno del sistema tienen prioridad sobre las de este archivo.
# Una variable vacía (VARIABLE=) se trata como si no estuviera definida.
#
# Obligatorias en TODOS los entornos: DATABASE_URL + DATABASE_SSL_CA_FILE (Postgres en Supabase) y
# SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY (login del panel con Supabase Auth). El resto tiene un valor por defecto seguro.
# ---------------------------------------------------------------------------

# Entorno: development | test | production
# En production se exige FRONTEND_ORIGIN y las cookies de sesión pasan a ser "Secure" (solo HTTPS).
NODE_ENV=development

# Puerto donde escucha la API.
PORT=4000

# Interfaz donde escucha. Por defecto 127.0.0.1 (solo esta máquina): lo recomendado detrás de un proxy
# inverso en el mismo servidor (Caddy, nginx). En Docker o en un PaaS (Render, Railway, Fly) hay que usar
# HOST=0.0.0.0 para que la plataforma pueda llegar al proceso.
HOST=127.0.0.1

# Origen(es) del frontend permitidos por CORS y por el chequeo de Origin (defensa CSRF).
# Tiene que ser EXACTAMENTE el origen que ve el navegador: esquema + host + puerto, sin barra final ni ruta.
#  - Desarrollo (Vite): http://localhost:5173
#  - Producción: el dominio público, ej.: https://mgdetailing.com.ar
# Para varios orígenes, separalos con comas. Útil para probar desde el celular por la red local:
#   FRONTEND_ORIGIN=http://localhost:5173,http://192.168.0.10:5173
# Obligatorio en producción. No se aceptan comodines (*).
FRONTEND_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Supabase Auth: login del panel (ver README, "Supabase Auth: usuarios y roles").
# El backend habla con Supabase Auth; el navegador nunca ve tokens ni claves.
# ---------------------------------------------------------------------------

# URL del proyecto, sin barra final. De acá se derivan /auth/v1 (emisor de los tokens) y el JWKS.
SUPABASE_URL=https://iclsiweaqhupxvxbpekl.supabase.co

# Clave PUBLISHABLE (Project Settings > API Keys > "Publishable key", empieza con sb_publishable_).
# Acá NO va la secret key (sb_secret_...): el servidor no arranca con ella en esta variable.
SUPABASE_PUBLISHABLE_KEY=

# Opcional. Clave SECRET (Project Settings > API Keys > "Secret keys", empieza con sb_secret_). Solo la usa el
# backend para que el superadmin cree y elimine usuarios del panel y les cambie el email o la contraseña.
# Es un SECRETO que salta RLS en todo el proyecto: nunca la subas al repo ni la pongas en el frontend.
# Sin ella el panel funciona igual, pero esas acciones quedan deshabilitadas.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Base de datos: Postgres en Supabase (único motor; ver README, "Base de datos" y "Conectar Supabase").
# ---------------------------------------------------------------------------

# OBLIGATORIA. Cadena de conexión de Supabase (Session pooler, puerto 5432) con el ROL DEDICADO mgdetailing_app, NO con postgres.
# La contraseña la genera `npm run clave-db` (ver README, "Conectar Supabase"); el host lo da el panel (botón "Connect").
# Reemplazá [YOUR-PASSWORD] por esa contraseña (sin corchetes). Es un SECRETO: nunca la subas al repo.
# Ejemplo (el host exacto, aws-0 o aws-1 y la región, copialo del panel):
# DATABASE_URL=postgresql://mgdetailing_app.iclsiweaqhupxvxbpekl:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Certificado raíz de Supabase para verificar al servidor (TLS verify-full). Se descarga del panel:
# Database > Settings > SSL Configuration > "Download certificate". Ruta relativa a backend/ o absoluta.
# Obligatorio con Postgres remoto en cualquier entorno (también en tu PC): sin él, el backend no arranca.
# DATABASE_SSL_CA_FILE=./certs/supabase-ca.crt

# Cuántos proxies inversos hay entre el visitante y la API, para que el rate limit vea la IP real
# (X-Forwarded-For). Valores: false (sin proxy), un número (1 = un proxy, ej. Caddy/nginx/PaaS) o una lista
# de IP/CIDR de confianza (ej.: 10.0.0.0/8, loopback). "true" NO se acepta: permitiría falsear la IP.
# Si lo dejás en false detrás de un proxy, todos los visitantes comparten la IP del proxy.
# Con Caddy/nginx en la MISMA máquina usá TRUST_PROXY=loopback (y HOST=127.0.0.1): solo se cree el
# X-Forwarded-For que llega desde el proxy local. Con un número (1), si el puerto de Node quedara expuesto a
# Internet, cualquiera podría conectarse directo, inventar su X-Forwarded-For y saltear el rate limit.
TRUST_PROXY=false

# true: la API también sirve el build del frontend (../frontend/dist) con fallback SPA a index.html
# para las rutas que no empiezan con /api. Es la forma de desplegar en un solo proceso y mismo origen.
SERVE_FRONTEND=false

# ---------------------------------------------------------------------------
# Avisos por WhatsApp al dueño cuando entra un turno nuevo (ver README, "Avisos por WhatsApp").
# Los datos del cliente (nombre, teléfono, vehículo, comentario) viajan al proveedor elegido.
# ---------------------------------------------------------------------------

# Origen público del sitio (sin ruta). Opcional: si está, el aviso incluye el link al panel (<PUBLIC_URL>/admin).
# PUBLIC_URL=https://mgdetailing.com.ar

# Proveedor: none (default, sin avisos) | callmebot (gratis, no oficial) | cloud (WhatsApp Cloud API de Meta)
# | telegram (bot de Telegram, gratis y oficial; es un aviso por Telegram, no por WhatsApp).
WHATSAPP_PROVIDER=none

# Número del dueño que recibe los avisos: código de país + número, solo dígitos (La Rioja: 549380 + número).
# WHATSAPP_OWNER_PHONE=5493804781737

# --- callmebot: la apikey te la manda el bot de CallMeBot por WhatsApp. Con la apikey vacía los avisos
# --- quedan desactivados (en desarrollo, con una advertencia; en producción el servidor no arranca).
# CALLMEBOT_APIKEY=

# --- telegram: token de @BotFather y chat id (ver README, "Opción 3: Telegram").
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- cloud: plantilla aprobada en Meta con UNA variable en el cuerpo ({{1}}).
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# WHATSAPP_CLOUD_TEMPLATE=nuevo_turno
# Idioma de la plantilla: es_AR (default) o es.
# WHATSAPP_CLOUD_LANGUAGE=es_AR
