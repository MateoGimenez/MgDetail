{
  "name": "mgdetailing-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de MgDetailing: solicitudes de turno y panel de administración",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clave-db": "node dist/scripts/clave-db.js",
    "clave-db:dev": "tsx src/scripts/clave-db.ts",
    "normalizar-telefonos": "node dist/scripts/normalizar-telefonos.js",
    "normalizar-telefonos:dev": "tsx src/scripts/normalizar-telefonos.ts"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cookie": "^2.0.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "libphonenumber-js": "^1.13.15",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
